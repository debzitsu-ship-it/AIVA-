<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Only allow connections to NVIDIA API endpoints -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">integrate.api.nvidia.com</domain>
        <domain includeSubdomains="true">grpc.nvcf.nvidia.com</domain>
        
        <!-- Enforce certificate pinning for NVIDIA endpoints -->
        <pin-set expiration="2027-01-01">
            <!-- Add actual pin hashes when deploying -->
            <!-- <pin algorithm="SHA-256">BASE64_HASH_HERE</pin> -->
        </pin-set>
        
        <!-- Trust standard CAs -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    
    <!-- Debug overrides for development -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
    
    <!-- Base config for all other domains - block by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>